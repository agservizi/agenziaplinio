# ---------------------------------
# Configurazione generale
# ---------------------------------
APP_NAME="AG Servizi"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://agenziaplinio.it

# ---------------------------------
# Sicurezza
# ---------------------------------
# Chiavi di crittografia per CSRF e sessioni
APP_KEY=your-32-character-random-key-here
CSRF_SECRET=your-32-character-random-key-here

# Configurazione sessioni sicure
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# Rate limiting
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=150

# Sicurezza password
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Sicurezza file upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,gif
UPLOAD_PATH=uploads/

# Sicurezza headers
CSP_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff

# Logging sicurezza
LOG_SECURITY_EVENTS=true
LOG_AUDIT_EVENTS=true
LOG_LEVEL=warning

# ---------------------------------
# Database MySQL
# ---------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=agenziaplinio
DB_USERNAME=secure_user
DB_PASSWORD=strong_secure_password_123!

# ---------------------------------
# Mail SMTP
# ---------------------------------
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=noreply@agenziaplinio.it
MAIL_PASSWORD=secure_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@agenziaplinio.it
MAIL_FROM_NAME="AG Servizi"

# ---------------------------------
# Resend (opzionale)
# ---------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_ADDRESS="AG SERVIZI VIA PLINIO 72 <noreply@agenziaplinio.it>"
RESEND_CONTACT_TO=info@agenziaplinio.it
RESEND_CONTACT_BCC=

# ---------------------------------
# Pagamenti Klarna
# ---------------------------------
KLARNA_API_BASE_URL=https://api.klarna.com
KLARNA_API_USERNAME=your_klarna_username
KLARNA_API_PASSWORD=your_klarna_password
KLARNA_TERMS_URL=https://agenziaplinio.it/termini
KLARNA_CHECKOUT_SUCCESS_URL=https://agenziaplinio.it/?page=account
KLARNA_CHECKOUT_CANCEL_URL=https://agenziaplinio.it/?page=cart
KLARNA_NOTIFICATION_URL=https://agenziaplinio.it/webhooks/klarna

# ---------------------------------
# Klarna On-site Messaging
# ---------------------------------
KLARNA_ONSITE_ENABLED=true
KLARNA_ONSITE_CLIENT_ID=your_klarna_client_id
KLARNA_ONSITE_THEME=default
KLARNA_ONSITE_LOCALE=it-IT
KLARNA_ONSITE_PLACEMENT_PRODUCT=credit-promotion-badge
KLARNA_ONSITE_PLACEMENT_CART=credit-promotion-checkout
KLARNA_WEB_SDK_CLIENT_ID=
KLARNA_WEBHOOK_TOKEN=
KLARNA_ENV=live

# ---------------------------------
# Pagamenti Stripe
# ---------------------------------
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_CHECKOUT_SUCCESS_URL=https://agenziaplinio.it/?page=account
STRIPE_CHECKOUT_CANCEL_URL=https://agenziaplinio.it/?page=cart
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret